# Copy to docker/.env and edit. Used by:
#   docker compose -f docker/docker-compose.yml --env-file docker/.env up --build -d web api
#
# Recommended: StarT (this compose) + MinerU on a GPU host (separate mineru:latest).

# --- Required for translate / reading AI / metadata identify (OpenAI-compatible) ---
# Used by: EN→ZH translation, reading-room chat, AI biblio extract (then Crossref/arXiv enrich).
# NOT used by: MinerU layout parse, Crossref/arXiv HTTP itself.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Host ports for StarT (change if occupied) ---
START_WEB_PORT=3000
START_API_PORT=8080

# --- MinerU (separate Docker on GPU server; product images do NOT include MinerU) ---
# Remote server (typical):
MINERU_API_URL=http://<server-ip>:8000
# MinerU on the same machine as StarT containers:
# MINERU_API_URL=http://host.docker.internal:8000
#
# On the GPU server (MinerU repo), after building mineru:latest:
#   cd docker && docker compose -f compose.yaml --profile api up -d
# That maps host 8000 -> container 8000.
