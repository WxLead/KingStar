# KingStar API (BFF)
FROM python:3.12-slim

WORKDIR /app

# Override if needed: docker compose build --build-arg APT_MIRROR=deb.debian.org api
ARG APT_MIRROR=mirrors.aliyun.com
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i "s/deb.debian.org/${APT_MIRROR}/g; s/security.debian.org/${APT_MIRROR}/g" \
        /etc/apt/sources.list.d/debian.sources; \
    elif [ -f /etc/apt/sources.list ]; then \
      sed -i "s/deb.debian.org/${APT_MIRROR}/g; s/security.debian.org/${APT_MIRROR}/g" \
        /etc/apt/sources.list; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      fontconfig \
    && rm -rf /var/lib/apt/lists/*

COPY services/parse /app/services/parse
COPY services/translate /app/services/translate
COPY services/api /app/services/api

# Install project SimSun + Times as system fonts so @font-face local("SimSun") /
# local("Times New Roman") work inside Chromium PDF (same path as Windows Translation).
# Do NOT use fonts-noto-cjk here — it substitutes the wrong face and still tofu in Edge.
RUN set -eux; \
    mkdir -p /usr/local/share/fonts/start; \
    cp /app/services/translate/assets/fonts/SIMSUN.TTF /usr/local/share/fonts/start/SimSun.ttf; \
    cp /app/services/translate/assets/fonts/TIMES.TTF /usr/local/share/fonts/start/TimesNewRoman.ttf; \
    fc-cache -f

RUN pip install --no-cache-dir -e /app/services/parse -e /app/services/translate -e /app/services/api \
    && playwright install --with-deps chromium || true

ENV START_DATA_DIR=/data \
    MINERU_API_URL=http://host.docker.internal:8000 \
    START_API_HOST=0.0.0.0 \
    START_API_PORT=8080

VOLUME ["/data"]
EXPOSE 8080

WORKDIR /app/services/api
CMD ["uvicorn", "start_api.main:app", "--host", "0.0.0.0", "--port", "8080"]
